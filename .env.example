# ============================================================
# YWM Dashboard — Environment Variables Template
# Copy this file to .env.local and fill in your values
# ============================================================

# ── Supabase Configuration ──
# Get these from your Supabase project dashboard (Settings → API)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key — NEVER expose to client-side code
# Used only in Vercel serverless functions (api/ directory)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── EmailJS Configuration (optional) ──
# Used for contact form on the public website
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# ── Formspree Backup (optional) ──
# Alternative email delivery for contact form
VITE_FORMSPREE_ENDPOINT=

# ── API Authentication (optional) ──
# If set, API endpoints require matching x-api-key header or Authorization: Bearer
# If not set, all API requests are allowed (for development)
YWM_API_KEY=

# ── CORS Configuration ──
# Comma-separated list of allowed origins
# Defaults to https://teknikywm.vercel.app if not set
CORS_ORIGIN=https://teknikywm.vercel.app

# ── Vercel Deployment ──
# Set automatically by Vercel, no need to configure manually
# VERCEL=1
